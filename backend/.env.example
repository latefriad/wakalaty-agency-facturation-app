DATABASE_URL="postgresql://wakalati:wakalati_secret@localhost:5432/wakalati"
DIRECT_URL="postgresql://wakalati:wakalati_secret@localhost:5432/wakalati"
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV="development"
# Origines CORS + base des liens publics dans les e-mails.
# Prod : le domaine (apex + www, séparés par des virgules).
FRONTEND_URL="http://localhost:3000"
# Prod exemple : FRONTEND_URL="https://wakalati.app,https://www.wakalati.app"

